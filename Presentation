<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Junior Astronaut Mission Trainer: Introduction</title>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,700;6..96,900&family=Playfair+Display:wght@500&family=Source+Serif+4:wght@300;400&display=swap" rel="stylesheet">
<style>
:root{--p:#e2dedb;--b:#cdc6be;--ink:#1d1d1b;--ch:#69645f;--em:#c03f13}
*{box-sizing:border-box;margin:0}
html,body{height:100%;overflow:hidden}html{background:var(--p)}
body{background:var(--p);color:var(--ink);font:300 clamp(17px,1.5vw,21px)/1.3 'Source Serif 4',Georgia,serif;letter-spacing:-.01em;overflow-x:hidden}
.top{position:fixed;top:0;left:0;right:0;height:48px;z-index:10;background:var(--p);border-bottom:1px solid var(--ink);display:flex;justify-content:space-between;align-items:center;padding:0 clamp(16px,3vw,40px);font-size:17px}
#pg{position:fixed;top:48px;left:0;height:3px;width:0;background:var(--em);z-index:10;transition:width .8s cubic-bezier(.77,0,.18,1)}
.slide{position:fixed;left:0;right:0;top:48px;bottom:0;overflow-y:auto;padding:40px clamp(20px,4vw,56px) 88px;display:flex;flex-direction:column;justify-content:center;visibility:hidden;transform:translateX(100%);transition:transform .8s cubic-bezier(.77,0,.18,1),visibility 0s .8s}
.slide.bef{transform:translateX(-100%)}.slide.cur{transform:none;visibility:visible;transition-delay:0s}.slide.bef,.slide.aft{visibility:visible}
.slide.dark{background:var(--ink);color:var(--p)}
.in{width:100%;max-width:1440px;margin:0 auto;display:flex;flex-direction:column;gap:28px}
.d{font-family:'Bodoni Moda',serif;font-weight:900;text-transform:uppercase;line-height:.8;letter-spacing:-.05em}
.xl{font-size:clamp(60px,16vw,240px)}.lg{font-size:clamp(48px,10vw,150px)}.md{font-size:clamp(34px,5.5vw,80px);line-height:.9}
.dom{font-family:'Playfair Display',serif;font-weight:500;letter-spacing:-.03em;line-height:.95}
.tag{display:inline-block;align-self:flex-start;background:var(--em);color:var(--p);border-radius:2.88px;padding:3px 9px;font-size:14px;letter-spacing:0}
.src{font-size:14px;color:var(--ch)}.dark .src{color:#a9a29a}
.g2,.g3{display:grid;gap:14px}.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}
@media(max-width:820px){.g2,.g3{grid-template-columns:1fr}}
.card{background:var(--b);color:var(--ink);border-radius:11.52px;padding:24px;box-shadow:-4px 4px 6px rgba(29,29,27,.2);display:flex;flex-direction:column;gap:12px}
.big{font-family:'Bodoni Moda',serif;font-weight:900;font-size:clamp(56px,9vw,130px);line-height:.85;letter-spacing:-.05em}
.big em{font-style:normal;color:var(--em)}
.lead{font-size:clamp(20px,2.2vw,32px);line-height:1.18;letter-spacing:-.025em;max-width:38ch}
p.dc::first-letter{font-family:'Bodoni Moda',serif;font-weight:900;float:left;font-size:4.2em;line-height:.8;padding:6px 10px 0 0;color:var(--em)}
.stamp{border:2px dashed var(--ink);border-radius:11.52px;padding:22px;display:flex;gap:18px;align-items:center;max-width:420px;background:var(--p)}
.stamp small{display:block;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--ch)}
.pp{display:inline-block;width:16px;height:16px;border:1.5px solid var(--ink);margin-right:5px}.pp.on{background:var(--ink)}
.job{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-top:1px solid var(--ink)}.job:first-child{border:0}
.rb{display:grid;grid-template-columns:minmax(120px,190px) 1fr 88px;gap:14px;align-items:center;margin:14px 0}
.rb i{display:block;height:24px;background:var(--p)}.rb i.e{background:var(--em)}
table{border-collapse:collapse;width:100%}td{padding:14px 10px 14px 0;border-top:1px solid var(--ink);vertical-align:top}td:first-child{font-family:'Playfair Display',serif;font-weight:500;letter-spacing:-.02em;font-size:1.15em;width:36%}
.go{display:inline-block;align-self:flex-start;background:var(--ink);color:var(--p);padding:16px 30px;border-radius:2.88px;text-decoration:none;font-size:20px}
a.go:hover{background:#000}
.hint{font-size:14px;color:var(--ch)}
/* build-in animations, like slide builds in PowerPoint */
.a{opacity:0;transform:translateY(40px);transition:opacity .7s,transform .8s cubic-bezier(.2,.7,.2,1);transition-delay:calc(var(--i,0)*.11s + .45s)}
.cur .a{opacity:1;transform:none}
.slide:not(.cur) .a,.slide:not(.cur) .rb i{transition:none}
.card.a{transform:translateY(60px) scale(.95)}.cur .card.a{transform:none}
.d.a{opacity:1;transform:translateY(30%);clip-path:inset(100% 0 0 0)}
.cur .d.a{transform:none;clip-path:inset(-25% -6% -25% -6%);transition:transform .9s cubic-bezier(.2,.7,.2,1) .35s,clip-path .9s cubic-bezier(.2,.7,.2,1) .35s}
.stamp.a{transform:rotate(-14deg) scale(1.3)}.cur .stamp.a{transform:rotate(-2deg) scale(1)}
.stamp svg{animation:spin 20s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}
.rb i{transform-origin:left;transform:scaleX(0);transition:transform 1.1s cubic-bezier(.2,.7,.2,1);transition-delay:calc(.9s + var(--i,0)*.12s)}
.cur .rb i{transform:none}
.tag{transition:transform .3s}.tag:hover{transform:rotate(-3deg) scale(1.06)}
#ctl{position:fixed;right:20px;bottom:20px;display:flex;gap:8px;z-index:9}
#ctl button{width:48px;height:48px;background:var(--p);color:var(--ink);border:1px solid var(--ink);border-radius:2.88px;font:22px 'Source Serif 4',serif;cursor:pointer;transition:background .2s,color .2s}
#ctl button:hover{background:var(--em);color:var(--p)}#ctl button:focus-visible{outline:2px solid var(--em);outline-offset:2px}
@media(prefers-reduced-motion:reduce){.slide,.a,.rb i,#pg{transition:none!important}.a,.d.a,.stamp.a{opacity:1;transform:none;clip-path:none}.rb i{transform:none}.stamp svg{animation:none}}
</style></head><body>
<div class="top"><span>NASA Space Apps 2026</span><span>Junior Astronaut Mission Trainer</span><span id="n">01 / 07</span></div><div id="pg"></div>

<section class="slide"><div class="in">
  <span class="tag">Challenge 2026</span>
  <p class="dom md">Build a Junior Astronaut</p>
  <h1 class="d xl">Mission<br>Trainer</h1>
  <div class="g2" style="align-items:end">
    <p class="dc lead">A game that lets students run a Moon or Mars outpost, and feel first-hand the trade-offs that decide whether a real mission survives.</p>
    <div class="stamp"><svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" stroke="#c03f13" stroke-width="3" stroke-linecap="round"><circle cx="32" cy="32" r="9" fill="#c03f13"/><path d="M32 4v12M32 48v12M4 32h12M48 32h12M12 12l8 8M44 44l8 8M12 52l8-8M44 20l8-8"/></svg><div><b class="dom" style="font-size:22px">Mission briefing</b><small>Slide deck · 7 pages · NASA data</small></div></div>
  </div>
  <p class="hint">Press the right arrow key, or use the buttons, to begin.</p>
</div></section>

<section class="slide dark"><div class="in">
  <h2 class="d lg">We are<br>going back.</h2>
  <div class="g3">
    <div class="card"><span class="big" data-n="1972" data-from="1900">1972</span><p>The last time astronauts flew to the Moon, until Artemis 2. That gap is more than 50 years.</p></div>
    <div class="card"><span class="big"><em data-n="2026" data-from="1990">2026</em></span><p>On 1 April, Artemis 2 launched with Reid Wiseman, Victor Glover, Christina Koch and Jeremy Hansen on a crewed loop around the Moon.</p></div>
    <div class="card"><span class="big" data-n="2028" data-from="1995">2028</span><p>NASA hopes Artemis 4 will land four astronauts near the lunar south pole, the start of a planned permanent base.</p></div>
  </div>
  <p class="src">Source: news coverage of NASA's Artemis program. Dates are plans and may change.</p>
</div></section>

<section class="slide"><div class="in">
  <div class="g2" style="gap:40px;align-items:center">
    <div style="display:flex;flex-direction:column;gap:22px">
      <h2 class="d lg">The<br>problem.</h2>
      <p class="lead">Space lessons often flatten the engineering trade-offs that define a mission, or bury them in detail. Very few tools make those choices tangible and fun.</p>
    </div>
    <div class="card"><h3 class="dom" style="font-size:34px">Our answer: run the outpost</h3>
      <p>Four astronauts. Thirty days. Every day you read the forecast and split your crew across five jobs.</p>
      <div>
        <div class="job"><span>Solar panels</span><span><i class="pp on"></i><i class="pp on"></i><i class="pp"></i><i class="pp"></i></span></div>
        <div class="job"><span>Oxygen maker</span><span><i class="pp on"></i><i class="pp"></i><i class="pp"></i><i class="pp"></i></span></div>
        <div class="job"><span>Greenhouse</span><span><i class="pp on"></i><i class="pp"></i><i class="pp"></i><i class="pp"></i></span></div>
        <div class="job"><span>Radiation wall</span><span><i class="pp"></i><i class="pp"></i><i class="pp"></i><i class="pp"></i></span></div>
        <div class="job"><span>Rest &amp; exercise</span><span><i class="pp"></i><i class="pp"></i><i class="pp"></i><i class="pp"></i></span></div>
      </div>
      <p class="src">Not enough hands for everything. That is the lesson.</p></div>
  </div>
</div></section>

<section class="slide dark"><div class="in">
  <h2 class="d lg">Air &amp;<br>water.</h2>
  <div class="g2">
    <div class="card"><span class="big"><em data-n="98" data-s="%">98%</em></span><p>of the water used on the International Space Station is now recovered. Sweat, breath and urine are cleaned and reused. Before a new brine processor, it was 93 to 94%.</p><p class="src">NASA, June 2023. Each crew member uses about a gallon a day.</p></div>
    <div class="card"><span class="big" data-n="122" data-s=" g">122 g</span><p>of oxygen made from Mars's carbon-dioxide air by the MOXIE experiment on Perseverance, over 16 runs. At its best it made 12 grams an hour.</p><p class="src">NASA, final run 7 August 2023. Martian air is about 96% carbon dioxide.</p></div>
  </div>
  <p class="lead">A rocket carrying four astronauts off Mars would need roughly 25,000 kg of oxygen. Making it on the spot beats hauling it. <span class="tag" style="display:inline-block">In the game: Oxygen maker</span></p>
</div></section>

<section class="slide"><div class="in">
  <h2 class="d lg">Power.</h2>
  <div class="g2">
    <div class="card"><span class="big"><span data-n="90" data-s=" days">90 days</span><br><em data-n="14.5" data-d="1" data-s=" years">14.5 years</em></span><p>Opportunity was planned for 90 days. Its solar panels kept it alive for about 14.5 years, until a Mars-wide dust storm in 2018 blocked the sunlight. Last contact was 10 June 2018.</p><p class="src">NASA / JPL. Curiosity, powered by plutonium, was not affected.</p></div>
    <div class="card"><span class="big"><em data-n="14">14</em> days<br>of night</span><p>On much of the Moon, daylight lasts a little over 14 Earth days, followed by 14 days of darkness and extreme cold, down to about −173 °C.</p><p class="src">NASA Glenn Research Center. Even at the south pole, no spot avoids darkness, so NASA plans to store power for up to eight days.</p></div>
  </div>
  <p class="lead">Solar panels are cheap and light, until the Sun goes away. <span class="tag" style="display:inline-block">In the game: dust storms &amp; lunar night</span></p>
</div></section>

<section class="slide dark"><div class="in">
  <h2 class="d lg">Radiation<br>&amp; food.</h2>
  <div class="g2" style="gap:40px">
    <div>
      <p class="dom" style="font-size:28px;margin-bottom:8px">Daily dose, in millisieverts</p>
      <div class="rb"><span>Mars surface</span><i style="width:33%"></i><span>0.64 to 0.7</span></div>
      <div class="rb"><span>Space Station</span><i style="width:35%"></i><span>0.4 to 1.0</span></div>
      <div class="rb"><span>Deep-space cruise</span><i class="e" style="width:90%"></i><span>about 1.8</span></div>
      <p>A full Mars trip of 360 days of travel and 500 on the surface adds up to about 1 sievert, roughly the career limit ESA uses for astronauts. "The hard part is the cruise," said the Curiosity radiation team's lead scientist.</p>
      <p class="src">NASA Curiosity RAD instrument, reported 2013. Mars's air is only 1% as thick as Earth's, and it has no global magnetic field.</p>
    </div>
    <div class="card"><span class="big" data-n="33" data-s=" days">33 days</span><p>On 10 August 2015, astronauts on the Space Station ate the first food grown in space: red romaine lettuce, harvested 33 days after planting in NASA's Veggie system.</p><p class="src">NASA says fresh plants may also lift crew mood on long missions.</p><span class="tag">In the game: Greenhouse &amp; Radiation wall</span></div>
  </div>
</div></section>

<section class="slide"><div class="in">
  <h2 class="d lg">From fact<br>to game.</h2>
  <table>
    <tr><td>Dust storms, lunar night</td><td>Solar panels lose power when the forecast turns. Store power ahead.</td></tr>
    <tr><td>Water and oxygen recycling</td><td>Oxygen maker: crew and power are spent to keep the air breathable.</td></tr>
    <tr><td>Space-grown lettuce</td><td>Greenhouse: food needs steady hands every day.</td></tr>
    <tr><td>Solar flares, cosmic rays</td><td>Radiation wall: a strong enough shield blocks a flare. Build it before the forecast hits.</td></tr>
  </table>
  <p class="src">Game numbers are simplified for play. They are not NASA figures. Sources: NASA and JPL (ISS life support 2023, MOXIE, Opportunity), NASA Glenn, NASA Artemis Base Camp concept, NASA Curiosity RAD, NASA Veggie 2015, and news coverage of Artemis 2.</p>
  <span class="go">Next: play the mission (mission-trainer-supernova.html)</span>
</div></section>

<div id="ctl"><button id="pv" aria-label="Previous slide">&larr;</button><button id="nx" aria-label="Next slide">&rarr;</button></div>
<script>
const S=[...document.querySelectorAll('.slide')],n=document.getElementById('n'),pg=document.getElementById('pg');
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;let cur=-1,lock=0;
S.forEach(s=>{let i=0;s.querySelectorAll('.in>*,.g2>*,.g3>*,.job,.rb,tr').forEach(el=>{el.classList.add('a');el.style.setProperty('--i',Math.min(i++,10))})});
function count(s){s.querySelectorAll('[data-n]').forEach(el=>{
  const to=+el.dataset.n,from=+(el.dataset.from||0),d=+(el.dataset.d||0),suf=el.dataset.s||'',k=el._k=(el._k||0)+1;
  if(reduce){el.textContent=to.toFixed(d)+suf;return}
  const t0=performance.now();
  (function f(t){if(el._k!==k)return;const p=Math.min(1,Math.max(0,(t-t0-500)/1500));
    el.textContent=(from+(to-from)*(1-Math.pow(1-p,3))).toFixed(d)+suf;if(p<1)requestAnimationFrame(f)})(t0)})}
function go(i){i=Math.max(0,Math.min(S.length-1,i));if(i===cur)return;
  S.forEach((s,k)=>{s.classList.toggle('cur',k===i);s.classList.toggle('bef',k<i);s.classList.toggle('aft',k>i)});
  cur=i;S[i].scrollTop=0;n.textContent=String(i+1).padStart(2,'0')+' / '+String(S.length).padStart(2,'0');
  pg.style.width=(i/(S.length-1))*100+'%';count(S[i]);try{history.replaceState(null,'','#'+(i+1))}catch(e){}}
const canScroll=dir=>{const s=S[cur];return dir>0?s.scrollTop+s.clientHeight<s.scrollHeight-2:s.scrollTop>0};
addEventListener('keydown',e=>{const k=e.key;
  if(k==='ArrowRight'){go(cur+1)}else if(k==='ArrowLeft'){go(cur-1)}
  else if(['ArrowDown','PageDown',' '].includes(k)){if(!canScroll(1)){e.preventDefault();go(cur+1)}}
  else if(['ArrowUp','PageUp'].includes(k)){if(!canScroll(-1)){e.preventDefault();go(cur-1)}}
  else if(k==='Home')go(0);else if(k==='End')go(S.length-1)});
addEventListener('wheel',e=>{const now=Date.now(),dn=e.deltaY>0;if(now<lock||Math.abs(e.deltaY)<20||canScroll(dn?1:-1))return;lock=now+900;go(cur+(dn?1:-1))},{passive:true});
let tx,ty;addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY},{passive:true});
addEventListener('touchend',e=>{const dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;if(Math.abs(dx)>60&&Math.abs(dx)>Math.abs(dy)*1.5)go(cur+(dx<0?1:-1))},{passive:true});
document.getElementById('nx').onclick=()=>go(cur+1);document.getElementById('pv').onclick=()=>go(cur-1);
go(Math.max(0,(parseInt(location.hash.slice(1))||1)-1));
</script></body></html>
